                    <label class="adm-field__label" for="s-name">نام فروشگاه</label>
                    <input class="input" type="text" id="s-name" value="ابزار شکری" readonly disabled>
                  </div>
                  <div class="adm-field">
                    <label class="adm-field__label" for="s-phone">تلفن</label>
                    <input class="input" type="tel" id="s-phone" value="۰۲۱-۴۴۵۵۶۶۷۷" dir="ltr" style="text-align:right" readonly disabled>
                  </div>
                  <div class="adm-field">
                    <label class="adm-field__label" for="s-email">ایمیل</label>
                    <input class="input" type="email" id="s-email" value="info@abzar-shokri.com" dir="ltr" style="text-align:right" readonly disabled>
                  </div>
                  <div class="adm-field adm-field--full">
                    <label class="adm-field__label" for="s-address">آدرس</label>
                    <input class="input" type="text" id="s-address" value="تهران، خیابان ولیعصر، پلاک ۱۲۳۴، مجتمع تجاری ابزار شکری" readonly disabled>
                  </div>
                  <div class="adm-field adm-field--full">
                    <label class="adm-field__label" for="s-desc">توضیح کوتاه فروشگاه</label>
                    <textarea class="input" id="s-desc" readonly disabled>فروشگاه تخصصی ابزارآلات صنعتی و ساختمانی با بیش از ۱۰ سال تجربه در ارائه بهترین برندهای ابزار جهان به هموطنان عزیز.</textarea>
                  </div>
                </div>
                <div class="adm-form-actions">
                  <button type="submit" class="btn btn-accent">ذخیره تغییرات</button>
                </div>
              </div>
            </form>

            <form class="adm-card" data-settings-form>
              <div class="adm-card__header">
                <div class="adm-card__titles">
                  <h2 class="adm-card__title">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                    روش‌های ارسال و پرداخت
                  </h2>
                  <span class="adm-card__sub">پیک، پست و درگاه‌های پرداخت</span>
                </div>
              </div>
              <div class="adm-card__body">
                <div class="adm-form-grid">
                  <div class="adm-field adm-field--full">
                    <label class="adm-field__label">روش ارسال پیش‌فرض</label>
                    <select class="input" id="s-ship-type" style="display:none" aria-hidden="true" tabindex="-1"></select>
                    <div id="ship-method-cards" style="display:flex;flex-wrap:wrap;gap:8px"></div>
                    <div id="ship-method-manage" style="margin-top:12px;display:flex;flex-direction:column;gap:8px"></div>
                    <div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap">
                      <input class="input" id="ship-new-name" placeholder="نام روش جدید" style="flex:2;min-width:140px">
                      <input class="input" id="ship-new-desc" placeholder="توضیح (اختیاری)" style="flex:2;min-width:140px">
                      <input class="input" id="ship-new-cost" placeholder="هزینه (تومان)" inputmode="numeric" style="flex:1;min-width:110px">
                      <button type="button" class="btn" id="ship-add-btn">افزودن روش</button>
                    </div>
                  </div>
                  <div class="adm-field">
                    <label class="adm-field__label" for="s-ship-cost">هزینه ارسال (تومان)</label>
                    <input class="input" type="text" id="s-ship-cost" value="۴۵٬۰۰۰">
                  </div>
                  <div class="adm-field">
                    <label class="adm-field__label" for="s-free-ship">ارسال رایگان از (تومان)</label>
                    <input class="input" type="text" id="s-free-ship" value="۵۰۰٬۰۰۰">
                  </div>
                </div>
                <div class="adm-card__body" style="padding:12px 0 0">
                  <div class="adm-switch-row">
                    <div class="adm-switch-row__meta">
                      <span class="adm-switch-row__title">درگاه پرداخت آنلاین</span>
                      <span class="adm-switch-row__desc">فعال‌سازی پرداخت از طریق درگاه زردپال</span>
                    </div>
                    <label class="adm-switch">
                      <input type="checkbox" checked>
                      <span class="adm-switch__track"></span>
                    </label>
                  </div>
                  <div class="adm-switch-row">
                    <div class="adm-switch-row__meta">
                      <span class="adm-switch-row__title">پرداخت در محل</span>
                      <span class="adm-switch-row__desc">امکان پرداخت هنگام تحویل کالا</span>
                    </div>
                    <label class="adm-switch">
                      <input type="checkbox">
                      <span class="adm-switch__track"></span>
                    </label>
                  </div>
                  <div class="adm-switch-row">
                    <div class="adm-switch-row__meta">
                      <span class="adm-switch-row__title">کارت به کارت</span>
                      <span class="adm-switch-row__desc">پرداخت از طریق انتقال بانکی</span>
                    </div>
                    <label class="adm-switch">
                      <input type="checkbox" checked>
                      <span class="adm-switch__track"></span>
                    </label>
                  </div>
                </div>
                <div class="adm-form-actions">
                  <button type="submit" class="btn btn-accent">ذخیره تغییرات</button>
                </div>
              </div>
            </form>

            <form class="adm-card" data-settings-form>
              <div class="adm-card__header">
                <div class="adm-card__titles">
                  <h2 class="adm-card__title">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                    اعلان‌ها
                  </h2>
                  <span class="adm-card__sub">هشدارها و اطلاع‌رسانی‌ها</span>
                </div>
              </div>
              <div class="adm-card__body">
                <div class="adm-switch-row">
                  <div class="adm-switch-row__meta">
                    <span class="adm-switch-row__title">اعلان سفارش جدید</span>
                    <span class="adm-switch-row__desc">هنگام ثبت هر سفارش جدید اعلان ارسال شود</span>
                  </div>
                  <label class="adm-switch">
                    <input type="checkbox" checked>
                    <span class="adm-switch__track"></span>
                  </label>
                </div>
                <div class="adm-switch-row">
                  <div class="adm-switch-row__meta">
                    <span class="adm-switch-row__title">هشدار موجودی کم</span>
                    <span class="adm-switch-row__desc">وقتی موجودی محصول به کمتر از ۵ عدد رسید</span>
                  </div>
                  <label class="adm-switch">
                    <input type="checkbox" checked>
                    <span class="adm-switch__track"></span>
                  </label>
                </div>
                <div class="adm-switch-row">
                  <div class="adm-switch-row__meta">
                    <span class="adm-switch-row__title">گزارش فروش هفتگی</span>
                    <span class="adm-switch-row__desc">ارسال ایمیل خلاصه فروش در پایان هفته</span>
                  </div>
                  <label class="adm-switch">
                    <input type="checkbox">
                    <span class="adm-switch__track"></span>
                  </label>
                </div>
                <div class="adm-form-actions">
                  <button type="submit" class="btn btn-accent">ذخیره تغییرات</button>
                </div>
              </div>
            </form>

            <form class="adm-card" data-settings-form id="adm-settings-purchase">
              <div class="adm-card__header">
                <div class="adm-card__titles">
                  <h2 class="adm-card__title">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                    تنظیمات خرید
                  </h2>
                  <span class="adm-card__sub">محدودیت‌های مبلغ و تعداد + دسترسی‌های خرید</span>
                </div>
              </div>
              <div class="adm-card__body">
                <div class="adm-form-grid">
                  <div class="adm-field">
                    <label class="adm-field__label" for="s-order-min">حداقل مبلغ سفارش (تومان)</label>
                    <input class="input" type="text" id="s-order-min" value="۰" inputmode="numeric">
                  </div>
                  <div class="adm-field">
                    <label class="adm-field__label" for="s-order-max">حداکثر مبلغ سفارش (تومان)</label>
                    <input class="input" type="text" id="s-order-max" value="۰" inputmode="numeric">
                  </div>
                  <div class="adm-field">
                    <label class="adm-field__label" for="s-qty-min">حداقل تعداد هر محصول</label>
                    <input class="input" type="number" id="s-qty-min" value="1" min="1" step="1">
                  </div>
                  <div class="adm-field">
                    <label class="adm-field__label" for="s-qty-max">حداکثر تعداد هر محصول</label>
                    <input class="input" type="number" id="s-qty-max" value="0" min="0" step="1">
                  </div>
                  <div class="adm-field adm-field--full">
                    <span class="adm-field__hint">مقدار ۰ برای مبالغ/حداکثر تعداد یعنی بدون محدودیت.</span>
                  </div>
                </div>
                <div class="adm-switch-row">
                  <div class="adm-switch-row__meta">
                    <span class="adm-switch-row__title">خرید مهمان</span>
                    <span class="adm-switch-row__desc">ثبت سفارش بدون ورود به حساب کاربری</span>
                  </div>
                  <label class="adm-switch">
                    <input type="checkbox" id="s-allow-guest" checked>
                    <span class="adm-switch__track"></span>
                  </label>
                </div>
                <div class="adm-switch-row">
                  <div class="adm-switch-row__meta">
                    <span class="adm-switch-row__title">ویرایش تعداد در سبد خرید</span>
                    <span class="adm-switch-row__desc">اجازه تغییر تعداد توسط مشتری</span>
                  </div>
                  <label class="adm-switch">
                    <input type="checkbox" id="s-allow-qedit" checked>
                    <span class="adm-switch__track"></span>
                  </label>
                </div>
                <div class="adm-switch-row">
                  <div class="adm-switch-row__meta">
                    <span class="adm-switch-row__title">خرید کالای ناموجود</span>
                    <span class="adm-switch-row__desc">اجازه خرید محصولات ناموجود در انبار</span>
                  </div>
                  <label class="adm-switch">
                    <input type="checkbox" id="s-allow-oos">
                    <span class="adm-switch__track"></span>
                  </label>
                </div>
                <div class="adm-form-actions">
                  <button type="submit" class="btn btn-accent">ذخیره تغییرات</button>
                </div>
              </div>
            </form>

            <div class="adm-card" id="adm-purchase-methods">
              <div class="adm-card__header">
                <div class="adm-card__titles">
                  <h2 class="adm-card__title">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                    روش‌های خرید
                  </h2>
                  <span class="adm-card__sub">هر روش پرداخت صفحه تنظیمات جداگانه خود را دارد</span>
                </div>
              </div>
              <div class="adm-card__body">
                <div class="adm-tabs" role="tablist" style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px">
                  <button type="button" class="btn" data-pm-tab="online" role="tab">پرداخت آنلاین</button>
                  <button type="button" class="btn" data-pm-tab="cod" role="tab">پرداخت در محل</button>
                  <button type="button" class="btn" data-pm-tab="card" role="tab">کارت به کارت</button>
                </div>
                <div data-pm-panel="online" role="tabpanel">
                  <div class="adm-form-grid">
                    <div class="adm-field adm-field--full">
                      <label class="adm-field__label" for="s-pay-online-title">عنوان روش</label>
                      <input class="input" type="text" id="s-pay-online-title" value="پرداخت آنلاین">
                    </div>
                    <div class="adm-field adm-field--full">
                      <label class="adm-field__label" for="s-pay-online-desc">توضیحات روش</label>
                      <textarea class="input" id="s-pay-online-desc" rows="2">پرداخت از طریق درگاه بانکی</textarea>
                    </div>
                  </div>
                  <div class="adm-switch-row">
                    <div class="adm-switch-row__meta">
                      <span class="adm-switch-row__title">فعال بودن روش</span>
                      <span class="adm-switch-row__desc">نمایش پرداخت آنلاین در تسویه‌حساب</span>
                    </div>
                    <label class="adm-switch">
                      <input type="checkbox" id="s-pay-online-enabled" checked>
                      <span class="adm-switch__track"></span>
                    </label>
                  </div>
                  <div class="adm-form-actions">
                    <button type="button" class="btn btn-accent" data-pm-save="online">ذخیره پرداخت آنلاین</button>
                  </div>
                </div>
                <div data-pm-panel="cod" role="tabpanel" hidden>
                  <div class="adm-form-grid">
                    <div class="adm-field adm-field--full">
                      <label class="adm-field__label" for="s-pay-cod-title">عنوان روش</label>
                      <input class="input" type="text" id="s-pay-cod-title" value="پرداخت در محل">
                    </div>
                    <div class="adm-field adm-field--full">
                      <label class="adm-field__label" for="s-pay-cod-desc">توضیحات روش</label>
                      <textarea class="input" id="s-pay-cod-desc" rows="2">پرداخت نقدی هنگام تحویل</textarea>
                    </div>
                  </div>
                  <div class="adm-switch-row">
                    <div class="adm-switch-row__meta">
                      <span class="adm-switch-row__title">فعال بودن روش</span>
                      <span class="adm-switch-row__desc">نمایش پرداخت در محل در تسویه‌حساب</span>
                    </div>
                    <label class="adm-switch">
                      <input type="checkbox" id="s-pay-cod-enabled">
                      <span class="adm-switch__track"></span>
                    </label>
                  </div>
                  <div class="adm-form-actions">
                    <button type="button" class="btn btn-accent" data-pm-save="cod">ذخیره پرداخت در محل</button>
                  </div>
                </div>
                <div data-pm-panel="card" role="tabpanel" hidden>
                  <div class="adm-form-grid">
                    <div class="adm-field adm-field--full">
                      <label class="adm-field__label" for="s-pay-card-title">عنوان روش</label>
                      <input class="input" type="text" id="s-pay-card-title" value="کارت به کارت">
                    </div>
                    <div class="adm-field adm-field--full">
                      <label class="adm-field__label" for="s-pay-card-desc">توضیحات روش</label>
                      <textarea class="input" id="s-pay-card-desc" rows="2">پرداخت از طریق انتقال بانکی</textarea>
                    </div>
                  </div>
                  <div class="adm-switch-row">
                    <div class="adm-switch-row__meta">
                      <span class="adm-switch-row__title">فعال بودن روش</span>
                      <span class="adm-switch-row__desc">نمایش کارت به کارت در تسویه‌حساب</span>
                    </div>
                    <label class="adm-switch">
                      <input type="checkbox" id="s-pay-card-enabled" checked>
                      <span class="adm-switch__track"></span>
                    </label>
                  </div>
                  <div class="adm-form-actions">
                    <button type="button" class="btn btn-accent" data-pm-save="card">ذخیره کارت به کارت</button>
                  </div>
                </div>
              </div>
            </div>

            <form class="adm-card" id="adm-change-password">
              <div class="adm-card__header">
                <div class="adm-card__titles">
                  <h2 class="adm-card__title">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    امنیت حساب
                  </h2>
                  <span class="adm-card__sub">تغییر رمز عبور مدیر و وضعیت نشست</span>
                </div>
              </div>
              <div class="adm-card__body">
                <div class="adm-form-grid">
                  <div class="adm-field adm-field--full">
                    <label class="adm-field__label" for="adm-current-pass">رمز عبور فعلی</label>
                    <input class="input" type="password" id="adm-current-pass" placeholder="••••••••">
                  </div>
                  <div class="adm-field">
                    <label class="adm-field__label" for="adm-new-pass">رمز عبور جدید</label>
                    <input class="input" type="password" id="adm-new-pass" placeholder="حداقل ۸ کاراکتر">
                  </div>
                  <div class="adm-field">
                    <label class="adm-field__label" for="adm-confirm-pass">تأیید رمز عبور</label>
                    <input class="input" type="password" id="adm-confirm-pass" placeholder="تکرار رمز عبور جدید">
                  </div>
                  <div class="adm-field adm-field--full">
                    <span class="adm-field__hint">رمز عبور باید شامل حداقل ۸ کاراکتر، یک حرف بزرگ و یک عدد باشد.</span>
                  </div>
                </div>
                <div class="adm-form-actions">
                  <button type="submit" class="btn btn-accent">به‌روزرسانی رمز عبور</button>
                </div>
              </div>
            </form>
          </div>
        </section>

        <!-- ─── SMS (پنل پیامک) ─────────────────────────────── -->
        <section class="admin-view" data-view="sms">
          <div class="adm-settings-grid">
            <form class="adm-card" id="adm-sms-form">
              <div class="adm-card__header">
                <div class="adm-card__titles">
                  <h2 class="adm-card__title">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    پنل پیامک
                  </h2>
                  <span class="adm-card__sub">تنظیمات سامانه پیامکی فروشگاه</span>
                </div>
              </div>
              <div class="adm-card__body">
                <div class="adm-switch-row">
                  <div class="adm-switch-row__meta">
                    <span class="adm-switch-row__title">فعال بودن پیامک</span>
                    <span class="adm-switch-row__desc">ارسال پیامک‌های سفارش، ثبت‌نام و تایید</span>
                  </div>
                  <label class="adm-switch">
                    <input type="checkbox" id="sms-enabled">
                    <span class="adm-switch__track"></span>
                  </label>
                </div>
                <div class="adm-form-grid">
                  <div class="adm-field">
                    <label class="adm-field__label" for="sms-provider">سرویس‌دهنده</label>
                    <select class="input" id="sms-provider">
                      <option value="kavenegar">کاوه‌نگار</option>
                      <option value="ghasedak">قاصدک</option>
                      <option value="melipayamak">ملی‌پیامک</option>
                      <option value="farazsms">فراز اس‌ام‌اس</option>
                      <option value="custom">سفارشی</option>
                    </select>
                  </div>
                  <div class="adm-field">
                    <label class="adm-field__label" for="sms-sender">شماره فرستنده</label>
                    <input class="input" type="text" id="sms-sender" dir="ltr" style="text-align:right" placeholder="مثل 10008663">
                  </div>
                  <div class="adm-field">
                    <label class="adm-field__label" for="sms-api-key">کلید API</label>
                    <input class="input" type="text" id="sms-api-key" dir="ltr" style="text-align:right" placeholder="API Key">
                  </div>
                  <div class="adm-field">
                    <label class="adm-field__label" for="sms-token">توکن / رمز</label>
                    <input class="input" type="text" id="sms-token" dir="ltr" style="text-align:right" placeholder="Token (اختیاری)">
                  </div>
                </div>
                <div class="adm-form-actions">
                  <button type="submit" class="btn btn-accent">ذخیره تنظیمات پیامک</button>
                </div>
              </div>
            </form>

            <div class="adm-card">
              <div class="adm-card__header">
                <div class="adm-card__titles">
                  <h2 class="adm-card__title">تست ارسال پیامک</h2>
                  <span class="adm-card__sub">ارسال پیام آزمایشی به یک شماره موبایل</span>
                </div>
              </div>
              <div class="adm-card__body">
                <div class="adm-form-grid">
                  <div class="adm-field adm-field--full">
                    <label class="adm-field__label" for="sms-test-to">شماره موبایل مقصد</label>
                    <input class="input" type="tel" id="sms-test-to" dir="ltr" style="text-align:right" placeholder="09123456789">
                  </div>
                </div>
                <div class="adm-form-actions">
                  <button type="button" class="btn" id="adm-sms-test">ارسال پیامک آزمایشی</button>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- ─── SEO (تنظیمات SEO) ───────────────────────────── -->
        <section class="admin-view" data-view="seo">
          <div class="adm-settings-grid">

            <div class="adm-card">
              <div class="adm-card__header">
                <div class="adm-card__titles">
                  <h2 class="adm-card__title">سئوی عمومی سایت</h2>
                  <span class="adm-card__sub">عنوان، متا و تنظیمات ایندکس پیش‌فرض همه صفحات</span>
                </div>
              </div>
              <div class="adm-card__body">
                <div class="adm-form-grid">
                  <div class="adm-field adm-field--full">
                    <label class="adm-field__label" for="seo-g-title">عنوان سایت (Site Title)</label>
                    <input class="input" type="text" id="seo-g-title">
                  </div>
                  <div class="adm-field adm-field--full">
                    <label class="adm-field__label" for="seo-g-desc">توضیحات متا پیش‌فرض (Meta Description)</label>
                    <textarea class="input" id="seo-g-desc" rows="2"></textarea>
                  </div>
                  <div class="adm-field adm-field--full">
                    <label class="adm-field__label" for="seo-g-kw">کلمات کلیدی پیش‌فرض (Keywords)</label>
                    <input class="input" type="text" id="seo-g-kw" dir="ltr" style="text-align:right">
                  </div>
                  <div class="adm-field">
                    <label class="adm-field__label" for="seo-g-robots">دستور ربات‌ها (Robots)</label>
                    <select class="input" id="seo-g-robots" dir="ltr" style="text-align:right">
                      <option value="index,follow">index,follow</option>
                      <option value="noindex,nofollow">noindex,nofollow</option>
                      <option value="index,nofollow">index,nofollow</option>
                      <option value="noindex,follow">noindex,follow</option>
                    </select>
                  </div>
                  <div class="adm-field">
                    <label class="adm-field__label" for="seo-g-gsc">کد تأیید Search Console</label>
                    <input class="input" type="text" id="seo-g-gsc" dir="ltr" style="text-align:right" placeholder="google-site-verification">
                  </div>
                </div>
                <div class="adm-form-actions">
                  <button type="button" class="btn btn-accent" data-seo-save-global="main">ذخیره سئوی عمومی</button>
                </div>
              </div>
            </div>

            <div class="adm-card">
              <div class="adm-card__header">
                <div class="adm-card__titles">
                  <h2 class="adm-card__title">Open Graph پیش‌فرض</h2>
                  <span class="adm-card__sub">نمایش لینک سایت در شبکه‌های اجتماعی</span>
                </div>
              </div>
              <div class="adm-card__body">
                <div class="adm-form-grid">
                  <div class="adm-field adm-field--full">
                    <label class="adm-field__label" for="seo-og-title">OG Title (خالی = عنوان سایت)</label>
                    <input class="input" type="text" id="seo-og-title">
                  </div>
                  <div class="adm-field adm-field--full">
                    <label class="adm-field__label" for="seo-og-desc">OG Description (خالی = توضیحات متا)</label>
                    <textarea class="input" id="seo-og-desc" rows="2"></textarea>
                  </div>
                  <div class="adm-field adm-field--full">
                    <label class="adm-field__label" for="seo-og-image">OG Image (آدرس تصویر)</label>
                    <input class="input" type="text" id="seo-og-image" dir="ltr" style="text-align:right" placeholder="assets/images/og-cover.jpg">
                  </div>
                </div>
                <div class="adm-form-actions">
                  <button type="button" class="btn btn-accent" data-seo-save-global="og">ذخیره Open Graph</button>
                </div>
              </div>
            </div>

            <div class="adm-card" style="grid-column:1/-1">
              <div class="adm-card__header">
                <div class="adm-card__titles">
                  <h2 class="adm-card__title">سئوی صفحات</h2>
                  <span class="adm-card__sub">عنوان، توضیحات و ایندکس هر صفحه — خالی = پیش‌فرض سراسری</span>
                </div>
                <div class="adm-card__actions">
                  <div class="adm-search">
                    <input type="search" id="adm-seo-page-search" placeholder="جستجوی صفحه…" aria-label="جستجوی صفحه">
                  </div>
                </div>
              </div>
              <div class="adm-table-wrap">
                <table class="adm-table">
                  <thead><tr><th>صفحه</th><th>SEO Title</th><th>SEO Description</th><th>ایندکس</th><th>عملیات</th></tr></thead>
                  <tbody id="adm-seo-page-list"><tr><td colspan="5" style="text-align:center;padding:20px;color:var(--text-muted)">در حال بارگذاری…</td></tr></tbody>
                </table>
              </div>
              <div class="adm-table-footer"><span class="adm-table-footer__meta" id="adm-seo-page-count"></span></div>
            </div>

            <div class="adm-card" style="grid-column:1/-1">
              <div class="adm-card__header">
                <div class="adm-card__titles">
                  <h2 class="adm-card__title">سئوی محصولات</h2>
                  <span class="adm-card__sub">عنوان و توضیحات اختصاصی هر محصول در نتایج جستجو</span>
                </div>
                <div class="adm-card__actions">
                  <div class="adm-search">
                    <input type="search" id="adm-seo-product-search" placeholder="جستجوی محصول…" aria-label="جستجوی محصول">
                  </div>
                </div>
              </div>
              <div class="adm-table-wrap">
                <table class="adm-table">
                  <thead><tr><th>محصول</th><th>SEO Title</th><th>SEO Description</th><th>ایندکس</th><th>عملیات</th></tr></thead>
                  <tbody id="adm-seo-product-list"><tr><td colspan="5" style="text-align:center;padding:20px;color:var(--text-muted)">در حال بارگذاری…</td></tr></tbody>
                </table>
              </div>
              <div class="adm-table-footer"><span class="adm-table-footer__meta" id="adm-seo-product-count"></span></div>
            </div>

            <div class="adm-card" style="grid-column:1/-1">
              <div class="adm-card__header">
                <div class="adm-card__titles">
                  <h2 class="adm-card__title">سئوی مقالات</h2>
                  <span class="adm-card__sub">عنوان و توضیحات اختصاصی هر مقاله در نتایج جستجو</span>
                </div>
                <div class="adm-card__actions">
                  <div class="adm-search">
                    <input type="search" id="adm-seo-article-search" placeholder="جستجوی مقاله…" aria-label="جستجوی مقاله">
                  </div>
                </div>
              </div>
              <div class="adm-table-wrap">
                <table class="adm-table">
                  <thead><tr><th>مقاله</th><th>SEO Title</th><th>SEO Description</th><th>ایندکس</th><th>عملیات</th></tr></thead>
                  <tbody id="adm-seo-article-list"><tr><td colspan="5" style="text-align:center;padding:20px;color:var(--text-muted)">در حال بارگذاری…</td></tr></tbody>
                </table>
              </div>
              <div class="adm-table-footer"><span class="adm-table-footer__meta" id="adm-seo-article-count"></span></div>
            </div>

          </div>
        </section>

