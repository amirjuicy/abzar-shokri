              <span class="adm-stat__icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></span>
              <div class="adm-stat__body">
                <span class="adm-stat__label">تعداد سفارش‌ها</span>
                <span class="adm-stat__value" id="adm-rep-orders">—</span>
              </div>
            </div>
            <div class="adm-card adm-stat adm-stat--green">
              <span class="adm-stat__icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
              <div class="adm-stat__body">
                <span class="adm-stat__label">تعداد مشتریان</span>
                <span class="adm-stat__value" id="adm-rep-customers">—</span>
              </div>
            </div>
          </div>

          <div class="adm-dash-grid">
            <div class="adm-card">
              <div class="adm-card__header">
                <div class="adm-card__titles">
                  <h2 class="adm-card__title"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>فروش بر اساس دوره</h2>
                  <span class="adm-card__sub" id="adm-rep-series-sub">نمودار فروش واقعی فروشگاه</span>
                </div>
                <div class="adm-card__actions">
                  <div class="adm-toolbar__filters" id="adm-rep-groups">
                    <button type="button" class="adm-chip is-active" data-group="day">روز</button>
                    <button type="button" class="adm-chip" data-group="week">هفته</button>
                    <button type="button" class="adm-chip" data-group="month">ماه</button>
                  </div>
                </div>
              </div>
              <div class="adm-card__body">
                <div class="adm-chart" id="adm-rep-chart"><p style="font-size:13px;color:var(--text-muted);padding:16px">در حال بارگذاری…</p></div>
                <div class="adm-chart__legend" id="adm-rep-legend"></div>
              </div>
            </div>

            <div class="adm-card">
              <div class="adm-card__header">
                <div class="adm-card__titles">
                  <h2 class="adm-card__title"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>تفکیک وضعیت سفارش‌ها</h2>
                  <span class="adm-card__sub">بر اساس داده واقعی سفارش‌ها</span>
                </div>
              </div>
              <div class="adm-card__body"><div class="adm-top-list" id="adm-rep-status"><p style="font-size:13px;color:var(--text-muted);padding:12px">در حال بارگذاری…</p></div></div>
            </div>
          </div>

          <div class="adm-card" style="margin-bottom:16px">
            <div class="adm-card__header"><div class="adm-card__titles"><h2 class="adm-card__title">جزئیات گزارش</h2><span class="adm-card__sub">جدول داده‌های گزارش انتخاب‌شده</span></div></div>
            <div class="adm-table-wrap"><table class="adm-table" id="adm-rep-table"><thead></thead><tbody><tr><td style="text-align:center;padding:20px;color:var(--text-muted)">گزارشی انتخاب نشده است.</td></tr></tbody></table></div>
          </div>
          <div class="adm-card">
            <div class="adm-card__header">
              <div class="adm-card__titles">
                <h2 class="adm-card__title"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>پرفروش‌ترین محصولات</h2>
                <span class="adm-card__sub">۱۰ محصول پرفروش بر اساس اقلام فروخته‌شده واقعی</span>
              </div>
            </div>
            <div class="adm-table-wrap">
              <table class="adm-table" id="adm-rep-top">
                <thead><tr><th>محصول</th><th>دسته</th><th>تعداد فروش</th><th>درآمد</th></tr></thead>
                <tbody><tr><td colspan="4" style="text-align:center;padding:28px;color:var(--text-muted)">در حال بارگذاری…</td></tr></tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- ─── Discounts ───────────────────────────────────── -->
        <section class="admin-view" data-view="discounts">
          <div class="adm-card">
            <div class="adm-card__header">
              <div class="adm-card__titles">
                <h2 class="adm-card__title">کدهای تخفیف</h2>
                <span class="adm-card__sub">ساخت و مدیریت کدهای تخفیف فروشگاه</span>
              </div>
            </div>
            <form id="adm-disc-form" style="display:flex;gap:8px;flex-wrap:wrap;padding:16px;border-bottom:1px solid var(--border-color-light)">
              <input type="hidden" id="adm-disc-id">
              <input class="input" id="adm-disc-code" placeholder="کد (مثل WELCOME10)" dir="ltr" style="max-width:160px" required>
              <select class="input" id="adm-disc-type" style="max-width:130px"><option value="fixed">مبلغ ثابت</option><option value="percent">درصدی</option></select>
              <input class="input" id="adm-disc-value" placeholder="مقدار" dir="ltr" style="max-width:120px" required>
              <input class="input" id="adm-disc-min" placeholder="حداقل سفارش" dir="ltr" style="max-width:130px">
              <input class="input" id="adm-disc-limit" placeholder="سقف دفعات (خالی=نامحدود)" dir="ltr" style="max-width:170px">
              <input class="input" id="adm-disc-exp" type="date" dir="ltr" style="max-width:160px">
              <label style="display:flex;align-items:center;gap:6px;font-size:13px"><input type="checkbox" id="adm-disc-enabled" checked> فعال</label>
              <button type="submit" class="btn btn-accent btn-sm" id="adm-disc-submit">ایجاد کد تخفیف</button>
              <button type="button" class="btn btn-secondary btn-sm" id="adm-disc-cancel" style="display:none">انصراف</button>
            </form>
            <div class="adm-toolbar">
              <div class="adm-search">
                <input type="search" id="adm-discounts-search" placeholder="جستجوی کد تخفیف…" aria-label="جستجوی کد تخفیف">
              </div>
            </div>
            <div class="adm-table-wrap">
              <table class="adm-table" id="adm-discounts-table">
                <thead><tr><th>کد</th><th>نوع</th><th>مقدار</th><th>حداقل سفارش</th><th>استفاده</th><th>انقضا</th><th>وضعیت</th><th>عملیات</th></tr></thead>
                <tbody></tbody>
              </table>
            </div>
            <div class="adm-table-footer"><span class="adm-table-footer__meta" id="adm-discounts-count"></span></div>
          </div>
        </section>

        <!-- ─── Orders ──────────────────────────────────────── -->
        <section class="admin-view" data-view="orders">
          <div class="adm-card">
            <div class="adm-card__header">
              <div class="adm-card__titles">
                <h2 class="adm-card__title">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                  مدیریت سفارش‌ها
                </h2>
                <span class="adm-card__sub">همه سفارش‌های ثبت‌شده در فروشگاه</span>
              </div>
              <div class="adm-card__actions">
                <button type="button" class="btn btn-secondary btn-sm" data-export>
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                  خروجی اکسل
                </button>
              </div>
            </div>

