      <span class="adm-card__sub">صفحات محتوایی ذخیره‌شده در دیتابیس + فایل‌های HTML موجود — ویرایش متن از اینجا روی سایت نمایش داده می‌شود</span>
    </div>
    <div class="adm-card__actions"><button type="button" class="btn btn-accent btn-sm" id="adm-page-new">+ صفحه جدید</button></div>
  </div>
  <div class="adm-toolbar"><div class="adm-search"><input type="search" id="adm-pages-search" placeholder="جستجوی صفحه… (نامک یا عنوان)"></div></div>
  <div class="adm-table-wrap"><table class="adm-table"><thead><tr><th>نامک / عنوان</th><th>آدرس</th><th>وضعیت</th><th>عملیات</th></tr></thead><tbody id="adm-pages-list"><tr><td colspan="4" style="text-align:center;padding:20px">در حال بارگذاری…</td></tr></tbody></table></div>
  <div class="adm-card__body" id="adm-page-editor" style="display:none;border-top:1px solid var(--border)">
    <form id="adm-page-form"><div class="adm-form-grid">
      <div class="adm-field"><label class="adm-field__label">نامک (slug)</label><input class="input" id="pg-slug" dir="ltr" placeholder="about"></div>
      <div class="adm-field"><label class="adm-field__label">وضعیت</label><select class="input" id="pg-status"><option value="published">منتشرشده</option><option value="draft">پیش‌نویس</option></select></div>
      <div class="adm-field adm-field--full"><label class="adm-field__label">عنوان</label><input class="input" id="pg-title"></div>
      <div class="adm-field adm-field--full"><label class="adm-field__label">خلاصه</label><input class="input" id="pg-excerpt"></div>
      <div class="adm-field adm-field--full"><label class="adm-field__label">متن صفحه (HTML مجاز است)</label><textarea class="input" id="pg-body" rows="8" dir="rtl"></textarea></div>
    </div><div class="adm-form-actions"><button type="submit" class="btn btn-accent">ذخیره صفحه</button><button type="button" class="btn btn-secondary" id="adm-page-preview">پیش‌نمایش</button><button type="button" class="btn btn-secondary" id="adm-page-cancel">انصراف</button></div></form>
  </div>
</div>

