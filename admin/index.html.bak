  </div>

  <div class="admin-overlay" aria-hidden="true"></div>

  <!-- ── Raw log viewer modal ─────────────────────────────── -->
  <div class="adm-modal" id="adm-logs-raw-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="adm-rawlog-title">
    <div class="adm-modal__backdrop" data-rawlog-close></div>
    <div class="adm-modal__box">
      <div class="adm-modal__header">
        <h3 class="adm-modal__title" id="adm-rawlog-title">لاگ خام</h3>
        <button type="button" class="btn btn-ghost btn-sm" data-rawlog-close>بستن</button>
      </div>
      <pre class="adm-rawlog__pre" id="adm-logs-raw-content">در حال بارگذاری…</pre>
    </div>
  </div>

  <!-- ── Product add/edit modal ─────────────────────────────── -->
  <div class="adm-modal" id="adm-product-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="adm-pm-title">
    <div class="adm-modal__backdrop" data-pm-close></div>
    <div class="adm-modal__box">
      <div class="adm-modal__header">
        <h3 class="adm-modal__title" id="adm-pm-title">افزودن محصول</h3>
        <button type="button" class="adm-btn-icon" data-pm-close aria-label="بستن">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <form id="adm-product-form" novalidate>
        <input type="hidden" id="adm-pm-id" value="">
        <div class="adm-form-grid">
          <div class="adm-field adm-field--full">
            <label class="adm-field__label" for="adm-pm-name">نام محصول *</label>
            <input class="input" type="text" id="adm-pm-name" placeholder="مثلاً دریل شارژی بوش مدل GSR 180-LI" required>
          </div>
          <div class="adm-field">
            <label class="adm-field__label" for="adm-pm-sku">کد SKU *</label>
            <input class="input" type="text" id="adm-pm-sku" dir="ltr" placeholder="BSH-GSR180" required>
          </div>
          <div class="adm-field">
            <label class="adm-field__label" for="adm-pm-brand">برند</label>
            <select class="input" id="adm-pm-brand"></select>
          </div>
          <div class="adm-field">
            <label class="adm-field__label" for="adm-pm-category">دسته‌بندی *</label>
            <select class="input" id="adm-pm-category" required></select>
          </div>
          <div class="adm-field">
            <label class="adm-field__label" for="adm-pm-price">قیمت (تومان) *</label>
            <input class="input" type="number" id="adm-pm-price" min="0" step="1000" placeholder="2850000" required>
          </div>
          <div class="adm-field">
            <label class="adm-field__label" for="adm-pm-wholesale">قیمت عمده (تومان)</label>
            <input class="input" type="number" id="adm-pm-wholesale" min="0" step="1000" placeholder="اختیاری">
          </div>
          <div class="adm-field">
            <label class="adm-field__label" for="adm-pm-stock">موجودی انبار (عدد) *</label>
            <input class="input" type="number" id="adm-pm-stock" min="0" step="1" placeholder="120" required>
          </div>
          <div class="adm-field">
            <label class="adm-field__label" for="adm-pm-status">وضعیت</label>
            <select class="input" id="adm-pm-status">
              <option value="active">فعال</option>
              <option value="inactive">غیرفعال</option>
              <option value="outofstock">ناموجود</option>
            </select>
          </div>
          <div class="adm-field adm-field--full">
            <label class="adm-field__label" for="adm-pm-image">تصویر محصول</label>
            <div class="adm-pm-imagepick">
              <span class="adm-pm-imagepick__preview" id="adm-pm-preview"><img src="../assets/images/products/bosch-gsr-180-li.svg" alt="پیش‌نمایش تصویر محصول"></span>
              <div style="flex:1;min-width:0;display:flex;gap:8px;align-items:center">
                <select class="input" id="adm-pm-image" style="flex:1;min-width:0"></select>
                <button type="button" class="btn btn-secondary btn-sm" data-media-target="adm-pm-image" style="white-space:nowrap;flex-shrink:0">آپلود تصویر</button>
              </div>
            </div>
            <span class="adm-field__hint">تصویر از میان تصاویر موجود فروشگاه انتخاب می‌شود.</span>
          </div>
          <div class="adm-field adm-field--full">
            <label class="adm-field__label" for="adm-pm-desc">توضیح کوتاه</label>
            <textarea class="input" id="adm-pm-desc" rows="2" placeholder="توضیح کوتاه محصول…"></textarea>
          </div>
          <div class="adm-field adm-field--full" id="adm-pm-features-wrap">
            <label class="adm-field__label">ویژگی‌ها</label>
            <div id="adm-pm-features" style="display:grid;gap:8px"></div>
            <button type="button" class="btn btn-secondary btn-sm" id="adm-pm-features-add" style="margin-top:8px">+ افزودن ویژگی</button>
          </div>
        </div>
        <div class="adm-form-actions">
          <button type="button" class="btn btn-secondary" data-pm-close>انصراف</button>
          <button type="submit" class="btn btn-accent" id="adm-pm-submit">ذخیره محصول</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ── Order details modal ────────────────────────────────── -->
  <div class="adm-modal" id="adm-order-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="adm-om-title">
