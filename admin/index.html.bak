            <div class="adm-modal__header"><h3 class="adm-modal__title" id="adm-export-title">خروجی Excel</h3><button type="button" class="btn btn-ghost btn-sm" data-export-close>×</button></div>
            <div style="padding:16px;display:flex;flex-direction:column;gap:12px">
              <label style="display:flex;gap:8px;align-items:center"><input type="radio" name="exp-type" value="full" checked> خروجی کامل محصولات</label>
              <label style="display:flex;gap:8px;align-items:center"><input type="radio" name="exp-type" value="summary"> خروجی خلاصه</label>
              <label style="display:flex;gap:8px;align-items:center"><input type="radio" name="exp-type" value="custom"> انتخاب دستی ستون‌ها</label>
              <div id="adm-export-cols" style="display:none;flex-wrap:wrap;gap:8px;max-height:240px;overflow:auto;border:1px solid var(--border-color-light);padding:8px;border-radius:8px"></div>
              <div style="display:flex;gap:8px;justify-content:flex-end"><button type="button" class="btn btn-secondary btn-sm" data-export-close>انصراف</button><button type="button" class="btn btn-accent btn-sm" id="adm-export-download">دانلود</button></div>
            </div>
          </div>
        </div>

