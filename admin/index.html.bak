                      <button type="button" class="adm-btn-icon" data-action="view" title="مشاهده"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button>
                      <button type="button" class="adm-btn-icon adm-btn-icon--danger" data-action="delete" title="حذف"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></button>
                    </div></td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div class="adm-table-footer">
              <span class="adm-table-footer__meta" id="adm-orders-count">نمایش ۱۲ از ۳۴۰ سفارش</span>
              <div class="adm-pagination">
                <button type="button" class="adm-pagination__btn" disabled>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
                </button>
                <button type="button" class="adm-pagination__btn is-active">۱</button>
                <button type="button" class="adm-pagination__btn">۲</button>
                <button type="button" class="adm-pagination__btn">۳</button>
                <button type="button" class="adm-pagination__btn">…</button>
                <button type="button" class="adm-pagination__btn">۲۹</button>
                <button type="button" class="adm-pagination__btn">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 6 9 12 15 18"/></svg>
                </button>
              </div>
            </div>
          </div>
        </section>

        <!-- ─── Transactions (تراکنش‌ها و پرداخت‌ها) ────────── -->
        <section class="admin-view" data-view="transactions">
          <div class="adm-card">
            <div class="adm-card__header">
              <div class="adm-card__titles">
                <h2 class="adm-card__title">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                  تراکنش‌ها و پرداخت‌ها
                </h2>
                <span class="adm-card__sub">نمای پرداخت هر سفارش — بدون داده تکراری</span>
              </div>
            </div>

            <div class="adm-stats" style="padding:16px 16px 0">
              <div class="adm-card adm-stat adm-stat--green">
                <span class="adm-stat__icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></span>
                <div class="adm-stat__body">
                  <span class="adm-stat__label">جمع مبالغ (فیلترشده)</span>
                  <span class="adm-stat__value" id="adm-tx-sum-amount">—</span>
                </div>
              </div>
              <div class="adm-card adm-stat adm-stat--blue">
                <span class="adm-stat__icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg></span>
                <div class="adm-stat__body">
                  <span class="adm-stat__label">تعداد تراکنش‌ها (فیلترشده)</span>
                  <span class="adm-stat__value" id="adm-tx-sum-count">—</span>
                </div>
              </div>
            </div>

            <div class="adm-toolbar">
              <div class="adm-toolbar__filters">
                <select class="input" id="adm-tx-status" style="width:auto;height:38px;border-radius:var(--radius-md);font-size:13px" aria-label="فیلتر وضعیت">
                  <option value="all">همه وضعیت‌ها</option>
                  <option value="pending">در انتظار</option>
                  <option value="successful">موفق</option>
                  <option value="failed">ناموفق</option>
                  <option value="refunded">مستردشده</option>
                </select>
                <select class="input" id="adm-tx-method" style="width:auto;height:38px;border-radius:var(--radius-md);font-size:13px" aria-label="فیلتر روش پرداخت">
                  <option value="all">همه روش‌ها</option>
                  <option value="online">آنلاین</option>
                  <option value="cod">پرداخت در محل</option>
                  <option value="card">کارت به کارت</option>
                </select>
                <input class="input" type="date" id="adm-tx-from" style="width:auto;height:38px" aria-label="از تاریخ">
                <input class="input" type="date" id="adm-tx-to" style="width:auto;height:38px" aria-label="تا تاریخ">
                <button type="button" class="btn btn-secondary btn-sm" data-tx-clear>حذف فیلترها</button>
              </div>
              <div class="adm-search">
                <input type="search" id="adm-tx-search" placeholder="جستجو (شناسه تراکنش، سفارش، موبایل)…" aria-label="جستجوی تراکنش">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              </div>
            </div>

            <div class="adm-table-wrap">
              <table class="adm-table" id="adm-tx-table">
                <thead>
                  <tr>
                    <th>شناسه تراکنش</th>
                    <th>سفارش</th>
                    <th>مشتری</th>
                    <th>مبلغ / روش</th>
                    <th>وضعیت</th>
                    <th>تاریخ</th>
                    <th>عملیات</th>
                  </tr>
                </thead>
                <tbody>
                  <tr><td colspan="7" style="text-align:center;padding:28px;color:var(--text-muted)">در حال بارگذاری…</td></tr>
                </tbody>
              </table>
            </div>

            <div class="adm-table-footer">
              <span class="adm-table-footer__meta">—</span>
              <div class="adm-pagination" id="adm-tx-pagination"></div>
            </div>
          </div>
        </section>

        <!-- ─── Transaction detail modal ─────────────────────── -->
        <div class="adm-modal" id="adm-tx-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="adm-tx-title">
          <div class="adm-modal__backdrop" data-tx-close></div>
          <div class="adm-modal__box" style="max-width:640px">
            <div class="adm-modal__header">
              <h3 class="adm-modal__title" id="adm-tx-title">جزئیات تراکنش</h3>
              <button type="button" class="btn btn-ghost btn-sm" data-tx-close>بستن</button>
            </div>
            <div id="adm-tx-body" style="max-height:60vh;overflow-y:auto"></div>
          </div>
        </div>

        <!-- ─── Products ────────────────────────────────────── -->
        <section class="admin-view" data-view="products">
          <div class="adm-card">
            <div class="adm-card__header">
              <div class="adm-card__titles">
