                    </div></td>
                  </tr>
                  <tr data-role="user" data-search="محمد حسینی mohammad@gmail.com 09384444444">
                    <td><span class="adm-user"><span class="adm-user__avatar">م</span><span class="adm-user__name">محمد حسینی</span></span><div class="adm-table__sub">mohammad@gmail.com</div></td>
                    <td><span class="adm-badge adm-badge--neutral adm-badge--plain">کاربر</span></td>
                    <td>۳۴</td>
                    <td>۲۶٬۵۰۰٬۰۰۰</td>
                    <td>۱۴۰۳/۰۱/۱۸</td>
                    <td><span class="adm-badge adm-badge--success">فعال</span></td>
                    <td><div class="adm-table__cell-actions">
                      <button type="button" class="adm-btn-icon" data-action="edit" title="ویرایش"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.83 2.83 0 0 1 4 4L7.5 20.5 2 22l1.5-5.5z"/></svg></button>
                      <button type="button" class="adm-btn-icon adm-btn-icon--danger" data-action="delete" title="حذف"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></button>
                    </div></td>
                  </tr>
                  <tr data-role="user" data-search="نگار صادقی negar@gmail.com 09395555555">
                    <td><span class="adm-user"><span class="adm-user__avatar">ن</span><span class="adm-user__name">نگار صادقی</span></span><div class="adm-table__sub">negar@gmail.com</div></td>
                    <td><span class="adm-badge adm-badge--neutral adm-badge--plain">کاربر</span></td>
                    <td>۸</td>
                    <td>۴٬۳۰۰٬۰۰۰</td>
                    <td>۱۴۰۳/۰۴/۱۲</td>
                    <td><span class="adm-badge adm-badge--danger">مسدود</span></td>
                    <td><div class="adm-table__cell-actions">
                      <button type="button" class="adm-btn-icon" data-action="edit" title="ویرایش"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.83 2.83 0 0 1 4 4L7.5 20.5 2 22l1.5-5.5z"/></svg></button>
                      <button type="button" class="adm-btn-icon adm-btn-icon--danger" data-action="delete" title="حذف"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></button>
                    </div></td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div class="adm-table-footer">
              <span class="adm-table-footer__meta">نمایش ۸ از ۲٬۱۴۸ کاربر</span>
              <div class="adm-pagination" id="adm-users-pagination"></div>
            </div>
          </div>
        </section>

        <!-- ─── Notifications (اعلان‌ها) ────────────────────── -->
        <section class="admin-view" data-view="notifications">
          <div class="adm-card">
            <div class="adm-card__header">
              <div class="adm-card__titles">
                <h2 class="adm-card__title">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                  اعلان‌ها
                </h2>
                <span class="adm-card__sub">اعلان‌های درون‌برنامه‌ای کاربران</span>
              </div>
              <div class="adm-card__actions">
                <button type="button" class="btn btn-accent btn-sm" data-nadd>
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                  اعلان جدید
                </button>
              </div>
            </div>

            <div class="adm-toolbar">
              <div class="adm-toolbar__filters">
                <select class="input" id="adm-notifs-type" style="width:auto;height:38px;border-radius:var(--radius-md);font-size:13px" aria-label="فیلتر نوع">
                  <option value="all">همه انواع</option>
                  <option value="info">اطلاع‌رسانی</option>
                  <option value="success">موفقیت</option>
                  <option value="warning">هشدار</option>
                  <option value="error">خطا</option>
                  <option value="promo">تبلیغاتی</option>
                </select>
                <select class="input" id="adm-notifs-active" style="width:auto;height:38px;border-radius:var(--radius-md);font-size:13px" aria-label="فیلتر وضعیت">
                  <option value="all">همه وضعیت‌ها</option>
                  <option value="1">فعال</option>
                  <option value="0">غیرفعال</option>
                </select>
              </div>
              <div class="adm-search">
                <input type="search" id="adm-notifs-search" placeholder="جستجوی اعلان… (عنوان یا متن)" aria-label="جستجوی اعلان">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              </div>
            </div>

            <div class="adm-table-wrap">
              <table class="adm-table" id="adm-notifs-table">
                <thead>
                  <tr>
                    <th>اعلان</th>
                    <th>نوع</th>
                    <th>مخاطب</th>
                    <th>وضعیت</th>
                    <th>خوانده شدن</th>
                    <th>تاریخ ایجاد</th>
                    <th>عملیات</th>
                  </tr>
                </thead>
                <tbody>
                  <tr><td colspan="7" style="text-align:center;padding:28px;color:var(--text-muted)">در حال بارگذاری…</td></tr>
                </tbody>
              </table>
            </div>

            <div class="adm-table-footer">
              <span class="adm-table-footer__meta">—</span>
              <div class="adm-pagination" id="adm-notifs-pagination"></div>
            </div>
          </div>
        </section>

        <!-- ─── Add/Edit notification modal ──────────────────── -->
        <div class="adm-modal" id="adm-notif-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="adm-nm-title">
          <div class="adm-modal__backdrop" data-nm-close></div>
          <div class="adm-modal__box">
            <div class="adm-modal__header">
              <h3 class="adm-modal__title" id="adm-nm-title">اعلان جدید</h3>
              <button type="button" class="btn btn-ghost btn-sm" data-nm-close>بستن</button>
            </div>
            <form id="adm-notif-form" novalidate>
              <input type="hidden" id="adm-nm-id" value="">
              <div class="adm-form-grid">
                <div class="adm-field adm-field--full">
                  <label class="adm-field__label" for="adm-nm-title2">عنوان *</label>
                  <input class="input" type="text" id="adm-nm-title2" required>
                </div>
                <div class="adm-field adm-field--full">
                  <label class="adm-field__label" for="adm-nm-message">متن اعلان *</label>
                  <textarea class="input" id="adm-nm-message" rows="3" required></textarea>
                </div>
                <div class="adm-field">
                  <label class="adm-field__label" for="adm-nm-type">نوع اعلان</label>
                  <select class="input" id="adm-nm-type">
                    <option value="info">اطلاع‌رسانی</option>
                    <option value="success">موفقیت</option>
                    <option value="warning">هشدار</option>
                    <option value="error">خطا</option>
                    <option value="promo">تبلیغاتی</option>
                  </select>
                </div>
                <div class="adm-field">
                  <label class="adm-field__label">وضعیت</label>
                  <label style="display:flex;align-items:center;gap:8px;font-size:13px"><input type="checkbox" id="adm-nm-active" checked> فعال</label>
                </div>
                <div class="adm-field">
                  <label class="adm-field__label" for="adm-nm-starts">تاریخ شروع (اختیاری)</label>
                  <input class="input" type="datetime-local" id="adm-nm-starts" dir="ltr" style="text-align:right">
                </div>
                <div class="adm-field">
                  <label class="adm-field__label" for="adm-nm-ends">تاریخ پایان (اختیاری)</label>
                  <input class="input" type="datetime-local" id="adm-nm-ends" dir="ltr" style="text-align:right">
                </div>
                <div class="adm-field adm-field--full">
                  <label class="adm-field__label" for="adm-nm-image">تصویر اعلان (اختیاری)</label>
                  <div style="display:flex;gap:8px;align-items:center">
                    <input class="input" type="url" id="adm-nm-image" placeholder="https://example.com/image.jpg" dir="ltr" style="flex:1">
                    <button type="button" class="btn btn-secondary btn-sm" id="adm-nm-upload-btn">آپلود تصویر</button>
                    <input type="file" id="adm-nm-file" accept="image/*" hidden>
                  </div>
                  <div id="adm-nm-preview" style="margin-top:8px;display:none;align-items:center;gap:8px">
                    <img id="adm-nm-preview-img" src="" alt="preview" style="width:72px;height:72px;object-fit:cover;border-radius:8px;border:1px solid var(--border-color-light)">
                    <button type="button" class="btn btn-ghost btn-sm" id="adm-nm-remove-img">حذف تصویر</button>
                  </div>
                  <div id="adm-nm-gallery" style="margin-top:8px;max-height:160px;overflow-y:auto;display:none;border:1px solid var(--border-color-light);border-radius:8px;padding:6px"></div>
                </div>
                <div class="adm-field">
                  <label class="adm-field__label" for="adm-nm-linktype">مقصد کلیک</label>
                  <select class="input" id="adm-nm-linktype">
                    <option value="">بدون لینک</option>
                    <option value="product">محصول</option>
                    <option value="category">دسته‌بندی</option>
                    <option value="custom">صفحه داخلی سفارشی</option>
                  </select>
                </div>
                <div class="adm-field" id="adm-nm-linkvalue-wrap" style="display:none">
                  <label class="adm-field__label" for="adm-nm-linkvalue">مقدار مقصد</label>
                  <input class="input" type="text" id="adm-nm-linkvalue" placeholder="مثال: shop.html یا category slug">
                </div>
                <div class="adm-field adm-field--full" id="adm-nm-product-wrap" style="display:none">
                  <label class="adm-field__label" for="adm-nm-product-search">انتخاب محصول</label>
                  <input class="input" type="search" id="adm-nm-product-search" placeholder="جستجوی محصول…">
                  <div id="adm-nm-product-results" style="margin-top:6px;max-height:180px;overflow-y:auto"></div>
                  <div id="adm-nm-product-pick" style="margin-top:6px"><span style="font-size:12px;color:var(--text-muted)">محصولی انتخاب نشده</span></div>
                </div>
                <div class="adm-field adm-field--full">
                  <span class="adm-field__label">مخاطب</span>
                  <div style="display:flex;gap:16px;font-size:13px;margin-bottom:8px">
                    <label style="display:flex;align-items:center;gap:6px"><input type="radio" name="adm-nm-target" id="adm-nm-target-all" checked> همه کاربران</label>
                    <label style="display:flex;align-items:center;gap:6px"><input type="radio" name="adm-nm-target" id="adm-nm-target-user"> کاربر خاص</label>
                  </div>
                  <div id="adm-nm-userwrap" style="display:none">
                    <input class="input" type="search" id="adm-nm-usersearch" placeholder="جستجوی کاربر (نام، موبایل، ایمیل)…" aria-label="جستجوی کاربر">
                    <div id="adm-nm-userresults" style="margin-top:6px;max-height:180px;overflow-y:auto"></div>
                    <div id="adm-nm-userpick" style="margin-top:6px"><span style="font-size:12px;color:var(--text-muted)">کاربری انتخاب نشده</span></div>
                  </div>
                </div>
              </div>
              <div class="adm-form-actions">
                <button type="button" class="btn btn-secondary" data-nm-close>انصراف</button>
                <button type="submit" class="btn btn-accent" id="adm-nm-submit">ایجاد اعلان</button>
              </div>
            </form>
          </div>
        </div>

        <!-- ─── View notification modal ──────────────────────── -->
        <div class="adm-modal" id="adm-notif-view-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="adm-nv-title">
          <div class="adm-modal__backdrop" data-nv-close></div>
          <div class="adm-modal__box">
            <div class="adm-modal__header">
              <h3 class="adm-modal__title" id="adm-nv-title">مشاهده اعلان</h3>
              <button type="button" class="btn btn-ghost btn-sm" data-nv-close>بستن</button>
            </div>
            <div id="adm-nv-body" style="max-height:60vh;overflow-y:auto"></div>
          </div>
        </div>

        <!-- ─── Tickets (پشتیبانی و تیکت‌ها) ─────────────────── -->
        <section class="admin-view" data-view="tickets">
          <div class="adm-card">
            <div class="adm-card__header">
              <div class="adm-card__titles">
                <h2 class="adm-card__title">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                  پشتیبانی و تیکت‌ها
                </h2>
                <span class="adm-card__sub">مدیریت تیکت‌های پشتیبانی مشتریان</span>
              </div>
              <div class="adm-card__actions">
                <button type="button" class="btn btn-accent btn-sm" data-tadd>
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                  تیکت جدید
                </button>
              </div>
            </div>

            <div class="adm-toolbar">
              <div class="adm-toolbar__filters">
                <select class="input" id="adm-tickets-status" style="width:auto;height:38px;border-radius:var(--radius-md);font-size:13px" aria-label="فیلتر وضعیت">
                  <option value="all">همه وضعیت‌ها</option>
                  <option value="open">باز</option>
                  <option value="pending">در انتظار</option>
                  <option value="answered">پاسخ داده‌شده</option>
                  <option value="closed">بسته</option>
                </select>
                <select class="input" id="adm-tickets-priority" style="width:auto;height:38px;border-radius:var(--radius-md);font-size:13px" aria-label="فیلتر اولویت">
                  <option value="all">همه اولویت‌ها</option>
                  <option value="urgent">فوری</option>
                  <option value="high">زیاد</option>
                  <option value="normal">معمولی</option>
                  <option value="low">کم</option>
                </select>
              </div>
              <div class="adm-search">
                <input type="search" id="adm-tickets-search" placeholder="جستجو (کاربر، موبایل، موضوع یا شماره تیکت)…" aria-label="جستجوی تیکت">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              </div>
            </div>

            <div class="adm-table-wrap">
              <table class="adm-table" id="adm-tickets-table">
                <thead>
                  <tr>
                    <th>تیکت</th>
                    <th>موضوع</th>
                    <th>مشتری</th>
                    <th>اولویت</th>
                    <th>وضعیت</th>
                    <th>آخرین فعالیت</th>
                    <th>عملیات</th>
                  </tr>
                </thead>
                <tbody>
                  <tr><td colspan="7" style="text-align:center;padding:28px;color:var(--text-muted)">در حال بارگذاری…</td></tr>
                </tbody>
              </table>
            </div>

            <div class="adm-table-footer">
              <span class="adm-table-footer__meta">—</span>
              <div class="adm-pagination" id="adm-tickets-pagination"></div>
            </div>
          </div>
        </section>

        <!-- ─── Ticket detail modal ──────────────────────────── -->
        <div class="adm-modal" id="adm-ticket-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="adm-tk-title">
          <div class="adm-modal__backdrop" data-tk-close></div>
          <div class="adm-modal__box" style="max-width:640px">
            <div class="adm-modal__header">
              <h3 class="adm-modal__title" id="adm-tk-title">گفتگوی تیکت</h3>
              <button type="button" class="btn btn-ghost btn-sm" data-tk-close>بستن</button>
            </div>
            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:10px">
              <span id="adm-tk-meta"></span>
              <select class="input" id="adm-tk-priority" style="width:auto;height:34px;font-size:12px" aria-label="اولویت">
                <option value="low">اولویت: کم</option>
                <option value="normal">اولویت: معمولی</option>
                <option value="high">اولویت: زیاد</option>
                <option value="urgent">اولویت: فوری</option>
              </select>
              <button type="button" class="btn btn-secondary btn-sm" id="adm-tk-toggle">بستن تیکت</button>
            </div>
            <div id="adm-tk-body" style="max-height:46vh;overflow-y:auto;padding:4px 2px"></div>
            <div id="adm-tk-replywrap" style="display:flex;gap:8px;margin-top:10px;align-items:center">
              <input type="file" id="adm-tk-file" hidden accept=".pdf,.jpg,.jpeg,.png,.webp,.doc,.docx">
              <button type="button" id="adm-tk-attach" title="پیوست" aria-label="پیوست فایل" style="width:36px;height:36px;display:inline-flex;align-items:center;justify-content:center;border:1px solid #e5e7eb;background:#fff;border-radius:10px;cursor:pointer;color:#6b7280;flex-shrink:0;transition:all .15s"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg></button>
              <textarea class="input" id="adm-tk-reply" rows="2" placeholder="پاسخ پشتیبانی…" style="flex:1"></textarea>
              <button type="button" class="btn btn-accent" id="adm-tk-send">ارسال</button>
            </div>
          </div>
        </div>

        <!-- ─── Create ticket modal ──────────────────────────── -->
        <div class="adm-modal" id="adm-ticket-create-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="adm-tc-title">
          <div class="adm-modal__backdrop" data-tc-close></div>
          <div class="adm-modal__box">
            <div class="adm-modal__header">
              <h3 class="adm-modal__title" id="adm-tc-title">تیکت جدید برای مشتری</h3>
              <button type="button" class="btn btn-ghost btn-sm" data-tc-close>بستن</button>
            </div>
            <form id="adm-tc-form" novalidate>
              <div class="adm-form-grid">
                <div class="adm-field adm-field--full">
                  <label class="adm-field__label" for="adm-tc-usersearch">مشتری *</label>
                  <input class="input" type="search" id="adm-tc-usersearch" placeholder="جستجوی کاربر (نام، موبایل، ایمیل)…" aria-label="جستجوی کاربر">
                  <div id="adm-tc-userresults" style="margin-top:6px;max-height:180px;overflow-y:auto"></div>
                  <div id="adm-tc-userpick" style="margin-top:6px"><span style="font-size:12px;color:var(--text-muted)">کاربری انتخاب نشده</span></div>
                </div>
                <div class="adm-field adm-field--full">
                  <label class="adm-field__label" for="adm-tc-subject">موضوع *</label>
                  <input class="input" type="text" id="adm-tc-subject" required>
                </div>
                <div class="adm-field">
                  <label class="adm-field__label" for="adm-tc-priority">اولویت</label>
                  <select class="input" id="adm-tc-priority">
                    <option value="normal">معمولی</option>
                    <option value="low">کم</option>
                    <option value="high">زیاد</option>
                    <option value="urgent">فوری</option>
                  </select>
                </div>
                <div class="adm-field adm-field--full">
                  <label class="adm-field__label" for="adm-tc-message">متن پیام *</label>
                  <textarea class="input" id="adm-tc-message" rows="3" required></textarea>
                </div>
              </div>
              <div class="adm-form-actions">
                <button type="button" class="btn btn-secondary" data-tc-close>انصراف</button>
                <button type="submit" class="btn btn-accent" id="adm-tc-submit">ایجاد تیکت</button>
              </div>
            </form>
          </div>
        </div>

        <!-- ─── Brands ──────────────────────────────────────── -->
        <section class="admin-view" data-view="brands">
          <div class="adm-card">
            <div class="adm-card__header">
              <div class="adm-card__titles">
                <h2 class="adm-card__title">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                  برندهای فروشگاه
                </h2>
                <span class="adm-card__sub">—</span>
              </div>
              <div class="adm-card__actions">
                <button type="button" class="btn btn-accent btn-sm" id="adm-add-brand-btn">
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                  افزودن برند
                </button>
              </div>
            </div>
            <div class="adm-card__body">
              <div class="adm-search" style="max-width:320px;margin-bottom:16px">
                <input type="search" id="adm-brands-search" placeholder="جستجوی برند…" aria-label="جستجوی برند">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              </div>
              <div class="adm-cat-grid" id="adm-brands-grid">
                <div style="grid-column:1/-1;text-align:center;padding:28px;color:var(--color-text-muted-dark)">در حال بارگذاری برندها…</div>
              </div>
            </div>
          </div>
        </section>

        <!-- ─── Articles ─────────────────────────────────────── -->
        <section class="admin-view" data-view="articles">
          <div class="adm-card">
            <div class="adm-card__header">
              <div class="adm-card__titles">
                <h2 class="adm-card__title">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                  مدیریت مقالات
                </h2>
                <span class="adm-card__sub">ایجاد و ویرایش مقالات فروشگاه</span>
              </div>
              <div class="adm-card__actions">
                <button type="button" class="btn btn-accent btn-sm" id="adm-add-article-btn">
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                  افزودن مقاله
                </button>
              </div>
            </div>
            <div class="adm-toolbar">
              <div class="adm-toolbar__filters">
                <button type="button" class="adm-chip is-active" data-status="all">همه</button>
                <button type="button" class="adm-chip" data-status="published">منتشرشده</button>
                <button type="button" class="adm-chip" data-status="draft">پیش‌نویس</button>
              </div>
              <div class="adm-search">
                <input type="search" id="adm-articles-search" placeholder="جستجوی مقاله…" aria-label="جستجوی مقاله">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              </div>
            </div>
            <div class="adm-table-wrap">
              <table class="adm-table" id="adm-articles-table">
                <thead><tr><th>تصویر</th><th>عنوان / نامک</th><th>خلاصه</th><th>دسته</th><th>وضعیت</th><th>به‌روزرسانی</th><th>عملیات</th></tr></thead>
                <tbody id="adm-articles-tbody"><tr><td colspan="7" style="text-align:center;padding:28px;color:var(--text-muted)">در حال بارگذاری…</td></tr></tbody>
              </table>
            </div>
            <div class="adm-table-footer"><span class="adm-table-footer__meta">—</span></div>
          </div>
          <div class="adm-modal" id="adm-article-modal" aria-hidden="true">
            <div class="adm-modal__backdrop" data-am-close></div>
            <div class="adm-modal__box" role="dialog" aria-modal="true">
              <div class="adm-modal__header"><h3 id="adm-am-title-label">افزودن مقاله</h3><button type="button" class="adm-btn-icon" data-am-close title="بستن">✕</button></div>
              <form id="adm-am-form">
                <input type="hidden" id="adm-am-id">
                <div class="adm-modal__body" style="display:grid;gap:12px">
                  <label>عنوان<input class="input" id="adm-am-title" required></label>
                  <label>نامک (slug)<input class="input" id="adm-am-slug" dir="ltr" placeholder="auto-from-title"></label>
                  <label>خلاصه<textarea class="input" id="adm-am-excerpt" rows="2"></textarea></label>
                  <label>محتوا<textarea class="input" id="adm-am-content" rows="6"></textarea></label>
                  <label>تصویر شاخص<div style="display:flex;gap:8px"><input class="input" id="adm-am-image" dir="ltr" placeholder="assets/images/..." style="flex:1"><button type="button" class="btn btn-secondary btn-sm" data-media-target="adm-am-image">آپلود تصویر</button></div></label>
                  <label>دسته<select class="input" id="adm-am-category"><option value="">— بدون دسته —</option></select></label>
                  <label>وضعیت<select class="input" id="adm-am-status"><option value="draft">پیش‌نویس</option><option value="published">منتشرشده</option></select></label>
                </div>
                <div class="adm-modal__footer"><button type="button" class="btn btn-secondary btn-sm" data-am-close>انصراف</button><button type="submit" class="btn btn-accent btn-sm" id="adm-am-submit">ذخیره مقاله</button></div>
              </form>
            </div>
          </div>
          <div class="adm-modal" id="adm-article-delete-modal" aria-hidden="true">
            <div class="adm-modal__backdrop" data-adel-close></div>
            <div class="adm-modal__box" role="dialog" aria-modal="true">
              <div class="adm-modal__header"><h3>حذف مقاله</h3></div>
              <div class="adm-modal__body"><p id="adm-adel-text">آیا از حذف این مقاله مطمئن هستید؟</p></div>
              <div class="adm-modal__footer"><button type="button" class="btn btn-secondary btn-sm" data-adel-close>انصراف</button><button type="button" class="btn btn-sm" id="adm-adel-confirm" style="background:var(--color-danger);color:#fff">حذف</button></div>
            </div>
          </div>
          <div class="adm-card" style="margin-top:16px">
            <div class="adm-card__header">
              <div class="adm-card__titles">
                <h2 class="adm-card__title">دسته‌بندی مقالات</h2>
                <span class="adm-card__sub">مدیریت دسته‌های مقالات فروشگاه</span>
              </div>
              <div class="adm-card__actions">
                <button type="button" class="btn btn-accent btn-sm" id="adm-add-article-cat-btn">افزودن دسته</button>
              </div>
            </div>
            <div class="adm-table-wrap">
              <table class="adm-table" id="adm-article-cats-table">
                <thead><tr><th>نام</th><th>نامک (slug)</th><th>تعداد مقالات</th><th>عملیات</th></tr></thead>
                <tbody id="adm-article-cats-tbody"><tr><td colspan="4" style="text-align:center;padding:28px;color:var(--text-muted)">در حال بارگذاری…</td></tr></tbody>
              </table>
            </div>
            <div class="adm-table-footer"><span class="adm-table-footer__meta" id="adm-article-cats-meta">—</span></div>
          </div>
          <div class="adm-modal" id="adm-article-cat-modal" aria-hidden="true">
            <div class="adm-modal__backdrop" data-ac-close></div>
            <div class="adm-modal__box" role="dialog" aria-modal="true">
              <div class="adm-modal__header"><h3 id="adm-ac-title-label">افزودن دسته</h3><button type="button" class="adm-btn-icon" data-ac-close title="بستن">✕</button></div>
              <form id="adm-ac-form">
                <input type="hidden" id="adm-ac-id">
                <div class="adm-modal__body" style="display:grid;gap:12px">
                  <label>نام دسته<input class="input" id="adm-ac-name" required></label>
                  <label>نامک (slug)<input class="input" id="adm-ac-slug" dir="ltr" placeholder="auto-from-name"></label>
                </div>
                <div class="adm-modal__footer"><button type="button" class="btn btn-secondary btn-sm" data-ac-close>انصراف</button><button type="submit" class="btn btn-accent btn-sm" id="adm-ac-submit">ذخیره دسته</button></div>
              </form>
            </div>
          </div>
          <div class="adm-modal" id="adm-article-cat-delete-modal" aria-hidden="true">
            <div class="adm-modal__backdrop" data-acdel-close></div>
            <div class="adm-modal__box" role="dialog" aria-modal="true">
              <div class="adm-modal__header"><h3>حذف دسته</h3></div>
              <div class="adm-modal__body"><p id="adm-acdel-text">آیا از حذف این دسته مطمئن هستید؟</p><label id="adm-acdel-reassign-wrap" style="display:none;margin-top:12px">انتقال مقالات به<select class="input" id="adm-acdel-reassign" style="margin-top:6px"></select></label></div>
              <div class="adm-modal__footer"><button type="button" class="btn btn-secondary btn-sm" data-acdel-close>انصراف</button><button type="button" class="btn btn-sm" id="adm-acdel-confirm" style="background:var(--color-danger);color:#fff">حذف</button></div>
            </div>
          </div>
        </section>

        <!-- ─── Reviews ──────────────────────────────────────── -->
        <section class="admin-view" data-view="reviews">
          <div class="adm-card">
            <div class="adm-card__header">
              <div class="adm-card__titles">
                <h2 class="adm-card__title">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                  نظرات و پرسش‌ها
                </h2>
                <span class="adm-card__sub">مدیریت نظرات و پرسش‌های محصولات</span>
              </div>
              <div class="adm-card__actions">
                <div role="tablist" aria-label="نوع موارد" style="display:flex;gap:8px">
                  <button type="button" class="btn btn-sm btn-accent" data-rq-tab="reviews" role="tab" aria-selected="true">نظرات</button>
                  <button type="button" class="btn btn-sm" data-rq-tab="questions" role="tab" aria-selected="false">پرسش‌ها</button>
                </div>
              </div>
            </div>
            <div class="adm-toolbar">
              <div class="adm-toolbar__filters">
                <select class="input" id="adm-reviews-status" style="width:auto;height:38px;border-radius:var(--radius-md);font-size:13px" aria-label="فیلتر وضعیت">
                  <option value="all">همه وضعیت‌ها</option>
                  <option value="pending">در انتظار بررسی</option>
                  <option value="approved">تأییدشده</option>
                  <option value="rejected">ردشده</option>
                </select>
                <select class="input" id="adm-reviews-rating" style="width:auto;height:38px;border-radius:var(--radius-md);font-size:13px">
                  <option value="all">همه امتیازها</option>
                  <option value="5">۵ ستاره</option>
                  <option value="4">۴ ستاره</option>
                  <option value="3">۳ ستاره</option>
                  <option value="2">۲ ستاره</option>
                  <option value="1">۱ ستاره</option>
                </select>
              </div>
              <div class="adm-search">
                <input type="search" id="adm-reviews-search" placeholder="جستجو (نام محصول، کاربر یا متن)…" aria-label="جستجو">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              </div>
            </div>
            <div class="adm-table-wrap">
              <table class="adm-table" id="adm-reviews-table">
                <thead><tr><th>محصول</th><th>نویسنده</th><th>امتیاز</th><th>نظر</th><th>تاریخ</th><th>وضعیت</th><th>عملیات</th></tr></thead>
                <tbody><tr><td colspan="7" style="text-align:center;padding:28px;color:var(--text-muted)">در حال بارگذاری…</td></tr></tbody>
              </table>
            </div>
            <div class="adm-table-footer">
              <span class="adm-table-footer__meta">—</span>
              <div class="adm-pagination" id="adm-reviews-pagination"></div>
            </div>
          </div>
        </section>

        <!-- ── Review view modal ──────────────────────────────── -->
        <div class="adm-modal" id="adm-review-view-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="adm-rv-title">
          <div class="adm-modal__backdrop" data-rv-close></div>
          <div class="adm-modal__box">
            <div class="adm-modal__header">
              <h3 class="adm-modal__title" id="adm-rv-title">مشاهده کامل</h3>
              <button type="button" class="btn btn-ghost btn-sm" data-rv-close>بستن</button>
            </div>
            <div id="adm-rv-body" style="max-height:60vh;overflow-y:auto"></div>
          </div>
        </div>

        <!-- ── Review reply modal ─────────────────────────────── -->
        <div class="adm-modal" id="adm-review-reply-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="adm-rr-title">
          <div class="adm-modal__backdrop" data-rr-close></div>
          <div class="adm-modal__box">
            <div class="adm-modal__header">
              <h3 class="adm-modal__title" id="adm-rr-title">پاسخ مدیر</h3>
              <button type="button" class="btn btn-ghost btn-sm" data-rr-close>بستن</button>
            </div>
            <div class="adm-form-grid">
              <div class="adm-field adm-field--full">
                <span class="adm-field__label">متن اصلی</span>
                <div id="adm-rr-quote" style="font-size:12px;color:var(--text-muted);padding:10px;border:1px dashed var(--border-color-light);border-radius:8px;white-space:pre-wrap"></div>
              </div>
              <div class="adm-field adm-field--full">
                <label class="adm-field__label" for="adm-rr-text">پاسخ شما</label>
                <textarea class="input" id="adm-rr-text" rows="4" placeholder="پاسخ مدیر فروشگاه…"></textarea>
              </div>
            </div>
            <div class="adm-form-actions">
              <button type="button" class="btn btn-secondary" data-rr-close>انصراف</button>
              <button type="button" class="btn btn-accent" id="adm-rr-submit">ثبت پاسخ</button>
            </div>
          </div>
        </div>

        <!-- ─── Content / CMS ─────────────────────────────────── -->
        <section class="admin-view" data-view="content">
          <form class="adm-card" id="adm-content-form">
            <div class="adm-card__header">
              <div class="adm-card__titles">
                <h2 class="adm-card__title">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                  محتوای سایت
                </h2>
                <span class="adm-card__sub">متن‌های قابل ویرایش صفحه اصلی و فروشگاه</span>
              </div>
            </div>
            <div class="adm-card__body">
              <div class="adm-form-grid">
                <div class="adm-field adm-field--full"><h3 style="margin:8px 0 0;font-size:14px">اسلایدهای هیرو</h3></div>
                <div class="adm-field adm-field--full" style="display:flex;gap:8px;align-items:center"><img id="c-hero-slide1-preview" src="" alt="preview 1" style="width:64px;height:64px;object-fit:contain;border:1px solid var(--border-color-light);border-radius:8px;background:#fff;padding:4px"><span style="font-size:12px;color:var(--text-muted)">اسلاید ۱ — پیش‌نمایش تصویر</span></div>
                <div class="adm-field adm-field--full"><label class="adm-field__label">اسلاید ۱ — تصویر</label><div style="display:flex;gap:8px"><input class="input" type="text" id="c-hero-slide1-image" data-content-key="hero.slide1.image" dir="ltr" style="flex:1" placeholder="assets/images/products/bosch-gsr-180-li.svg"><button type="button" class="btn btn-secondary btn-sm" data-media-target="c-hero-slide1-image">انتخاب تصویر</button></div></div>
                <div class="adm-field"><label class="adm-field__label">اسلاید ۱ — نشان</label><input class="input" type="text" id="c-hero-slide1-badge" data-content-key="hero.slide1.badge"></div>
                <div class="adm-field"><label class="adm-field__label">اسلاید ۱ — عنوان</label><input class="input" type="text" id="c-hero-slide1-title" data-content-key="hero.slide1.title"></div>
                <div class="adm-field adm-field--full"><label class="adm-field__label">اسلاید ۱ — متن</label><textarea class="input" id="c-hero-slide1-text" data-content-key="hero.slide1.text" rows="2"></textarea></div>
                <div class="adm-field adm-field--full"><label class="adm-field__label">اسلاید ۱ — لینک</label><input class="input" type="text" id="c-hero-slide1-link" data-content-key="hero.slide1.link" dir="ltr" placeholder="#bestsellers"></div>
                <div class="adm-field adm-field--full" style="display:flex;gap:8px;align-items:center"><img id="c-hero-slide2-preview" src="" alt="preview 2" style="width:64px;height:64px;object-fit:contain;border:1px solid var(--border-color-light);border-radius:8px;background:#fff;padding:4px"><span style="font-size:12px;color:var(--text-muted)">اسلاید ۲ — پیش‌نمایش</span></div>
                <div class="adm-field adm-field--full"><label class="adm-field__label">اسلاید ۲ — تصویر</label><div style="display:flex;gap:8px"><input class="input" type="text" id="c-hero-slide2-image" data-content-key="hero.slide2.image" dir="ltr" style="flex:1"><button type="button" class="btn btn-secondary btn-sm" data-media-target="c-hero-slide2-image">انتخاب تصویر</button></div></div>
                <div class="adm-field"><label class="adm-field__label">اسلاید ۲ — نشان</label><input class="input" type="text" id="c-hero-slide2-badge" data-content-key="hero.slide2.badge"></div>
                <div class="adm-field"><label class="adm-field__label">اسلاید ۲ — عنوان</label><input class="input" type="text" id="c-hero-slide2-title" data-content-key="hero.slide2.title"></div>
                <div class="adm-field adm-field--full"><label class="adm-field__label">اسلاید ۲ — متن</label><textarea class="input" id="c-hero-slide2-text" data-content-key="hero.slide2.text" rows="2"></textarea></div>
                <div class="adm-field adm-field--full"><label class="adm-field__label">اسلاید ۲ — لینک</label><input class="input" type="text" id="c-hero-slide2-link" data-content-key="hero.slide2.link" dir="ltr"></div>
                <div class="adm-field adm-field--full" style="display:flex;gap:8px;align-items:center"><img id="c-hero-slide3-preview" src="" alt="preview 3" style="width:64px;height:64px;object-fit:contain;border:1px solid var(--border-color-light);border-radius:8px;background:#fff;padding:4px"><span style="font-size:12px;color:var(--text-muted)">اسلاید ۳ — پیش‌نمایش</span></div>
                <div class="adm-field adm-field--full"><label class="adm-field__label">اسلاید ۳ — تصویر</label><div style="display:flex;gap:8px"><input class="input" type="text" id="c-hero-slide3-image" data-content-key="hero.slide3.image" dir="ltr" style="flex:1"><button type="button" class="btn btn-secondary btn-sm" data-media-target="c-hero-slide3-image">انتخاب تصویر</button></div></div>
                <div class="adm-field"><label class="adm-field__label">اسلاید ۳ — نشان</label><input class="input" type="text" id="c-hero-slide3-badge" data-content-key="hero.slide3.badge"></div>
                <div class="adm-field"><label class="adm-field__label">اسلاید ۳ — عنوان</label><input class="input" type="text" id="c-hero-slide3-title" data-content-key="hero.slide3.title"></div>
                <div class="adm-field adm-field--full"><label class="adm-field__label">اسلاید ۳ — متن</label><textarea class="input" id="c-hero-slide3-text" data-content-key="hero.slide3.text" rows="2"></textarea></div>
                <div class="adm-field adm-field--full"><label class="adm-field__label">اسلاید ۳ — لینک</label><input class="input" type="text" id="c-hero-slide3-link" data-content-key="hero.slide3.link" dir="ltr"></div>
                <div class="adm-field adm-field--full" style="display:flex;gap:8px;align-items:center"><img id="c-hero-slide4-preview" src="" alt="preview 4" style="width:64px;height:64px;object-fit:contain;border:1px solid var(--border-color-light);border-radius:8px;background:#fff;padding:4px"><span style="font-size:12px;color:var(--text-muted)">اسلاید ۴ — پیش‌نمایش</span></div>
                <div class="adm-field adm-field--full"><label class="adm-field__label">اسلاید ۴ — تصویر</label><div style="display:flex;gap:8px"><input class="input" type="text" id="c-hero-slide4-image" data-content-key="hero.slide4.image" dir="ltr" style="flex:1"><button type="button" class="btn btn-secondary btn-sm" data-media-target="c-hero-slide4-image">انتخاب تصویر</button></div></div>
                <div class="adm-field"><label class="adm-field__label">اسلاید ۴ — نشان</label><input class="input" type="text" id="c-hero-slide4-badge" data-content-key="hero.slide4.badge"></div>
                <div class="adm-field"><label class="adm-field__label">اسلاید ۴ — عنوان</label><input class="input" type="text" id="c-hero-slide4-title" data-content-key="hero.slide4.title"></div>
                <div class="adm-field adm-field--full"><label class="adm-field__label">اسلاید ۴ — متن</label><textarea class="input" id="c-hero-slide4-text" data-content-key="hero.slide4.text" rows="2"></textarea></div>
                <div class="adm-field adm-field--full"><label class="adm-field__label">اسلاید ۴ — لینک</label><input class="input" type="text" id="c-hero-slide4-link" data-content-key="hero.slide4.link" dir="ltr"></div>
                <div class="adm-field adm-field--full"><h3 style="margin:8px 0 0;font-size:14px">نوار تبلیغاتی بالا</h3></div>
                <div class="adm-field"><label class="adm-field__label">پیام ۱</label><input class="input" type="text" id="c-promo-topbar-1" data-content-key="promo.topbar.1"></div>
                <div class="adm-field"><label class="adm-field__label">پیام ۲</label><input class="input" type="text" id="c-promo-topbar-2" data-content-key="promo.topbar.2"></div>
                <div class="adm-field"><label class="adm-field__label">پیام ۳</label><input class="input" type="text" id="c-promo-topbar-3" data-content-key="promo.topbar.3"></div>
                <div class="adm-field adm-field--full"><h3 style="margin:8px 0 0;font-size:14px">فوتر</h3></div>
                <div class="adm-field adm-field--full"><label class="adm-field__label">توضیح برند فوتر</label><textarea class="input" id="c-footer-brand-desc" data-content-key="footer.brand.desc" rows="2"></textarea></div>
                <div class="adm-field adm-field--full"><label class="adm-field__label">آدرس فوتر</label><input class="input" type="text" id="c-footer-address" data-content-key="footer.address"></div>
