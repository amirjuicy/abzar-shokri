  <div class="adm-modal" id="adm-category-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="adm-cm-title">
    <div class="adm-modal__backdrop" data-cm-close></div>
    <div class="adm-modal__box">
      <div class="adm-modal__header">
        <h3 class="adm-modal__title" id="adm-cm-title">افزودن دسته</h3>
        <button type="button" class="adm-btn-icon" data-cm-close aria-label="بستن">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <form id="adm-category-form" novalidate>
        <input type="hidden" id="adm-cm-id" value="">
        <div class="adm-form-grid">
          <div class="adm-field adm-field--full">
            <label class="adm-field__label" for="adm-cm-name">نام دسته *</label>
            <input class="input" type="text" id="adm-cm-name" placeholder="مثلاً ابزار برقی" required>
          </div>
          <div class="adm-field">
            <label class="adm-field__label" for="adm-cm-slug">نامک (slug)</label>
            <input class="input" type="text" id="adm-cm-slug" dir="ltr" placeholder="power-tools">
          </div>
          <div class="adm-field">
            <label class="adm-field__label" for="adm-cm-color">رنگ</label>
            <input class="input" type="color" id="adm-cm-color" value="#1E88E5" style="height:42px;padding:4px">
          </div>
          <div class="adm-field adm-field--full">
            <label class="adm-field__label" for="adm-cm-desc">توضیح</label>
            <textarea class="input" id="adm-cm-desc" rows="2" placeholder="توضیح دسته…"></textarea>
          </div>
          <div class="adm-field adm-field--full">
            <label class="adm-field__label">زیر‌دسته‌ها</label>
            <div class="adm-subchips" id="adm-cm-subs"></div>
            <div style="display:flex;gap:8px;margin-top:8px">
              <input class="input" type="text" id="adm-cm-sub-input" placeholder="نام زیر‌دسته…" style="flex:1">
              <button type="button" class="btn btn-secondary btn-sm" id="adm-cm-sub-add">افزودن</button>
            </div>
          </div>
        </div>
        <div class="adm-form-actions">
          <button type="button" class="btn btn-secondary" data-cm-close>انصراف</button>
          <button type="submit" class="btn btn-accent" id="adm-cm-submit">ذخیره دسته</button>
        </div>
      </form>
    </div>
