        <!-- ─── Reports ─────────────────────────────────────── -->
        <section class="admin-view" data-view="reports">
          <div class="adm-card" style="margin-bottom:16px">
            <div class="adm-card__header">
              <div class="adm-card__titles">
                <h2 class="adm-card__title">گزارش‌ها</h2>
                <span class="adm-card__sub">گزارش واقعی فروشگاه</span>
              </div>
              <div class="adm-card__actions">
                <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
              <select id="adm-rep-kind" class="input" style="max-width:160px"><option value="orders">سفارش‌ها</option><option value="sales">فروش</option><option value="products">محصولات</option><option value="inventory">موجودی</option></select>
              <select id="adm-rep-range" class="input" style="max-width:160px"><option value="7days">۷ روز اخیر</option><option value="30days">۳۰ روز اخیر</option><option value="today">امروز</option><option value="yesterday">دیروز</option><option value="thisMonth">ماه جاری</option><option value="lastMonth">ماه گذشته</option><option value="thisYear">سال جاری</option><option value="lastYear">سال گذشته</option><option value="custom">سفارشی</option></select>
              <input type="date" id="adm-rep-from" class="input" style="max-width:150px;display:none">
              <input type="date" id="adm-rep-to" class="input" style="max-width:150px;display:none">
              <button type="button" class="btn btn-accent btn-sm" id="adm-rep-show">نمایش گزارش</button>
            </div>
                <button type="button" class="btn btn-secondary btn-sm" id="adm-rep-export">
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                  Export Excel
                </button>
              </div>
            </div>
          </div>
          <div class="adm-stats">
            <div class="adm-card adm-stat adm-stat--yellow">
              <span class="adm-stat__icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></span>
              <div class="adm-stat__body">
                <span class="adm-stat__label">درآمد فروش</span>
