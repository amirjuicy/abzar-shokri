                <button type="button" class="adm-chip" data-type="requests">requests</button>
                <button type="button" class="adm-chip" data-type="warnings">warnings</button>
                <button type="button" class="adm-chip" data-type="errors">errors</button>
                <button type="button" class="adm-chip" data-type="security">security</button>
              </div>
              <div class="adm-toolbar__filters" id="adm-logs-filters">
                <button type="button" class="adm-chip is-active" data-level="">همه</button>
                <button type="button" class="adm-chip" data-level="error">ERROR</button>
                <button type="button" class="adm-chip" data-level="warn">WARN</button>
                <button type="button" class="adm-chip" data-level="info">INFO</button>
