          <div class="adm-field"><label class="adm-field__label" for="adm-bm-logo">لوگو (مسیر)</label><div style="display:flex;gap:8px"><input class="input" type="text" id="adm-bm-logo" dir="ltr" placeholder="assets/images/brands/bosch.svg" style="flex:1"><button type="button" class="btn btn-secondary btn-sm" data-media-target="adm-bm-logo">آپلود تصویر</button></div></div>
          <div class="adm-field adm-field--full"><label class="adm-field__label" for="adm-bm-desc">توضیح</label><textarea class="input" id="adm-bm-desc" rows="2" placeholder="توضیح برند…"></textarea></div>
