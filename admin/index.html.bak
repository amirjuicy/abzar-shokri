        <input type="hidden" id="adm-am-id" value="">
        <div class="adm-form-grid">
          <div class="adm-field"><label class="adm-field__label" for="adm-am-username">نام کاربری *</label><input class="input" type="text" id="adm-am-username" dir="ltr" required></div>
          <div class="adm-field"><label class="adm-field__label" for="adm-am-name">نام نمایشی</label><input class="input" type="text" id="adm-am-name" placeholder="مدیر فروشگاه"></div>
          <div class="adm-field adm-field--full" id="adm-am-passrow"><label class="adm-field__label" for="adm-am-password">رمز عبور *</label><input class="input" type="password" id="adm-am-password" required placeholder="حداقل ۸ کاراکتر"></div>
          <div class="adm-field">
            <label class="adm-field__label" for="adm-am-role">نقش</label>
            <select class="input" id="adm-am-role">
              <option value="support">پشتیبانی</option>
              <option value="editor">ویراستار</option>
              <option value="manager">مدیر داخلی</option>
              <option value="viewer">ناظر (فقط‌خواندن)</option>
              <option value="admin">مدیر</option>
              <option value="superadmin">مدیر ارشد</option>
            </select>
          </div>
          <div class="adm-field">
            <label class="adm-field__label">وضعیت</label>
            <label style="display:flex;align-items:center;gap:8px;font-size:13px"><input type="checkbox" id="adm-am-active" checked> فعال</label>
          </div>
          <div class="adm-field adm-field--full">
            <label style="display:flex;align-items:center;gap:8px;font-size:13px"><input type="checkbox" id="adm-am-custom"> دسترسی‌های سفارشی (به‌جای پیش‌فرض نقش)</label>
          </div>
          <div class="adm-field adm-field--full" id="adm-am-permswrap" style="display:none">
            <span class="adm-field__label">بخش‌های مجاز</span>
            <div id="adm-am-perms"></div>
          </div>
        </div>
        <div class="adm-form-actions">
          <button type="button" class="btn btn-secondary" data-am-close>انصراف</button>
          <button type="submit" class="btn btn-accent" id="adm-am-submit">افزودن</button>
        </div>
      </form>
    </div>
  </div>

