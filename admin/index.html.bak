  <div class="adm-modal" id="adm-admin-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="adm-am-title">
    <div class="adm-modal__backdrop" data-am-close></div>
    <div class="adm-modal__box adm-modal__box--sm">
      <div class="adm-modal__header">
        <h3 class="adm-modal__title" id="adm-am-title">افزودن مدیر</h3>
        <button type="button" class="adm-btn-icon" data-am-close aria-label="بستن">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
